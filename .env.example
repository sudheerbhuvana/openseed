# OpenSeed Environment Configuration
# WireGuard VPN details for Gluetun container

# Timezone and Permissions
TZ=Asia/Kolkata
PUID=1000
PGID=1000

# Custom self-hosted WireGuard (e.g. Gluetun pointing to your VPS / VPN)
VPN_SERVICE_PROVIDER=custom
VPN_TYPE=wireguard
WIREGUARD_ENDPOINT_IP=your_vpn_server_ip
WIREGUARD_ENDPOINT_PORT=51820
WIREGUARD_PUBLIC_KEY=your_wireguard_public_key=
WIREGUARD_PRIVATE_KEY=your_wireguard_private_key=
WIREGUARD_PRESHARED_KEY=your_wireguard_preshared_key=
# NOTE: Allocate a unique peer IP (e.g. 10.8.0.2/32) so multiple hosts do not collide
WIREGUARD_ADDRESSES=10.8.0.2/32

# Seeding Incoming Port
SEEDING_PORT=51413

# qBittorrent Configuration
QBIT_USERNAME=admin
QBIT_PASSWORD=adminadmin

# Storage paths on host / VM
ISOS_DIR=./data/isos
QBIT_CONFIG_DIR=./data/qbittorrent

# OpenSeed Web & Automation
WEB_PORT=3000
ADMIN_PASSWORD=change_this_admin_password
CRON_SECRET=change_this_cron_secret
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_HOURS=6
MAX_VERSIONS_PER_DISTRO=3
MAX_DISK_PERCENT_LIMIT=90
MIN_RATIO_BEFORE_PRUNE=1.0
NEXT_PUBLIC_APP_NAME="OpenSeed"
